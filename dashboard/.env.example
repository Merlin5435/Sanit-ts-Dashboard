# Kopie dieser Datei als "dashboard/.env" speichern und ausfüllen. Die .env wird NICHT zu GitHub hochgeladen.

# Claude-API-Schlüssel (console.anthropic.com). Ohne Schlüssel läuft das Dashboard nach festen Regeln.
ANTHROPIC_API_KEY=

# Modell (Standard: claude-opus-5-5)
CLAUDE_MODELL=claude-opus-5-5

# test = Testwelt mit erfundenen Daten
DASHBOARD_MODUS=test
DASHBOARD_PORT=8090

# Uhrzeit des automatischen Abgleichs
ABGLEICH_STUNDE=5
ABGLEICH_MINUTE=0
