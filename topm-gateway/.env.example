# ---------------------------------------------------------------------------
# san6 / TopM-Webservice  (Werte aus san6: Vorbereitung -> "API-Schnittstelle")
# ---------------------------------------------------------------------------
SAN6_BASE_URL=https://IHR-SERVER:8084/inhouse.top
SAN6_COMPANY=IhrCompany
SAN6_PRODUCT=IhrProduct
SAN6_MANDANT=IhrMandant
# Systemnummer, die im san6 für dieses Gateway angelegt wurde (01-99)
SAN6_SYS=07
SAN6_PASSWORD=bitte-aendern
# md5 (empfohlen) oder basic
SAN6_AUTH_MODE=md5
# ohne_api = Hash ab Funktionsname (Beispiel Kap. 3.3.2); falls PING mit 02 antwortet: mit_api testen
SAN6_MD5_BASIS=ohne_api
# Nur setzen, wenn im san6 für dieses System TAN-Pflicht aktiviert ist (4-stellige Geräte-ID)
SAN6_TAN_DEVICE=
SAN6_MITARBEITER=
SAN6_TIMEOUT=60
SAN6_VERIFY_TLS=true
SAN6_POST_ENCODING=utf-8
SAN6_POST_WRAPPER=

# ---------------------------------------------------------------------------
# Gateway
# ---------------------------------------------------------------------------
# Schreib-/Lese-Keys (kommagetrennt), z.B. erzeugen mit: python -c "import secrets;print(secrets.token_urlsafe(32))"
GATEWAY_API_KEYS=
GATEWAY_READONLY_KEYS=
# Token für den iCal-Feed (Outlook-Abo kann keine Header senden)
GATEWAY_ICS_TOKEN=
GATEWAY_DB_PATH=./data/gateway.sqlite
GATEWAY_PORT=8080
# 1 = Sync-Worker läuft im selben Prozess (nur bei "python -m topm_gateway serve")
GATEWAY_EMBEDDED_WORKER=1
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Termin-Sync
# ---------------------------------------------------------------------------
SYNC_INTERVAL_MINUTES=15
SYNC_DAYS_BACK=7
SYNC_DAYS_AHEAD=90
# leer = alle Mitarbeiter; sonst z.B. 012,013,020
SYNC_MITARBEITER=
# san6-Mitarbeiternummer = Outlook-Postfach
SYNC_OUTLOOK_MAP=012=vorname.nachname@sanitaetshaus-nehls.de
# san6 | outlook – wer gewinnt, wenn ein Termin auf beiden Seiten geändert wurde
SYNC_CONFLICT_POLICY=san6
# Verschiebungen / Löschungen aus Outlook nach san6 zurückschreiben
SYNC_OUTLOOK_TO_SAN6=true
# Outlook-Termine mit dieser Kategorie werden in san6 neu angelegt (leer = aus)
SYNC_OUTLOOK_NEW_CATEGORY=
SYNC_OUTLOOK_NEW_TERMINART=01
# Controlling: Rechnungen der letzten N Tage täglich ins Archiv, ab Stunde X
SYNC_RECHNUNGEN_DAYS_BACK=40
SYNC_CONTROLLING_HOUR=2

# ---------------------------------------------------------------------------
# Microsoft 365 / Outlook (leer lassen = kein Outlook-Sync, nur REST + iCal)
# App-Registrierung mit Anwendungsberechtigung Calendars.ReadWrite + Admin-Zustimmung
# ---------------------------------------------------------------------------
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_CATEGORY=TopM san6
GRAPH_TIMEZONE=W. Europe Standard Time
